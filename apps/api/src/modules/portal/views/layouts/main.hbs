<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>{{theme.welcomeTitle}}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: {{theme.backgroundColor}};
      color: {{theme.textColor}};
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    {{#if theme.backgroundImageUrl}}
    body {
      background-image: url('{{theme.backgroundImageUrl}}');
      background-size: cover;
      background-position: center;
    }
    {{/if}}
    .portal-card {
      background: rgba(255, 255, 255, 0.95);
      border-radius: 16px;
      padding: 32px 24px;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 4px 24px rgba(0,0,0,0.12);
    }
    .portal-logo {
      max-width: 180px;
      max-height: 80px;
      margin: 0 auto 16px;
      display: block;
    }
    h1, h2 { text-align: center; margin-bottom: 8px; font-size: 22px; }
    .subtitle { text-align: center; color: #6B7280; margin-bottom: 24px; font-size: 14px; }
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 6px;
      color: {{theme.textColor}};
    }
    .form-group input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #D1D5DB;
      border-radius: 8px;
      font-size: 16px;
      outline: none;
      -webkit-appearance: none;
    }
    .form-group input:focus { border-color: {{theme.primaryColor}}; box-shadow: 0 0 0 3px {{theme.primaryColor}}22; }
    .btn-primary {
      background: {{theme.primaryColor}};
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 14px 24px;
      width: 100%;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      -webkit-appearance: none;
      transition: opacity 0.2s;
    }
    .btn-primary:active { opacity: 0.85; }
    .btn-secondary {
      background: transparent;
      color: {{theme.primaryColor}};
      border: 1px solid {{theme.primaryColor}};
      border-radius: 8px;
      padding: 12px 24px;
      width: 100%;
      font-size: 14px;
      cursor: pointer;
      margin-top: 8px;
      text-align: center;
      text-decoration: none;
      display: block;
    }
    .divider {
      text-align: center;
      color: #9CA3AF;
      margin: 20px 0;
      font-size: 13px;
      position: relative;
    }
    .divider::before, .divider::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 40%;
      height: 1px;
      background: #E5E7EB;
    }
    .divider::before { left: 0; }
    .divider::after { right: 0; }
    .error {
      background: #FEF2F2;
      color: #DC2626;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 14px;
      margin-bottom: 16px;
      text-align: center;
    }
    .success {
      background: #F0FDF4;
      color: #16A34A;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 14px;
      margin-bottom: 16px;
      text-align: center;
    }
    .footer {
      text-align: center;
      color: #9CA3AF;
      font-size: 12px;
      margin-top: 20px;
    }
    .terms { margin-top: 16px; font-size: 12px; }
    .terms summary { cursor: pointer; color: #6B7280; text-align: center; }
    .terms-content { margin-top: 8px; color: #6B7280; line-height: 1.5; max-height: 200px; overflow-y: auto; }
    .status-grid { margin: 16px 0; }
    .status-item {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #E5E7EB;
    }
    .status-item .label { color: #6B7280; font-size: 14px; }
    .status-item .value { font-weight: 600; font-size: 14px; }
    .package-option { display: block; margin-bottom: 12px; cursor: pointer; }
    .package-option input[type="radio"] { display: none; }
    .package-card {
      border: 2px solid #E5E7EB;
      border-radius: 12px;
      padding: 16px;
      transition: border-color 0.2s;
    }
    .package-option input:checked + .package-card { border-color: {{theme.primaryColor}}; }
    .package-card h3 { font-size: 16px; margin-bottom: 4px; }
    .package-card .speed { color: #6B7280; font-size: 13px; }
    .package-card .price { font-weight: 700; font-size: 18px; margin-top: 8px; color: {{theme.primaryColor}}; }
    {{{theme.customCss}}}
  </style>
</head>
<body>
  <div class="portal-card">
    {{#if theme.logoUrl}}
    <img src="{{theme.logoUrl}}" alt="Logo" class="portal-logo">
    {{/if}}
    {{{body}}}
    {{#if theme.footerText}}
    <p class="footer">{{theme.footerText}}</p>
    {{/if}}
  </div>
</body>
</html>
